<div class="bg-[#F1F1F1] text-black w-full rounded-lg px-8 pb-8">
  <%= form_with(model: [project, item], class: 'w-full', remote: false) do |form| %>
    <div class="flex justify-end my-4">
      <%= form.submit 'Save', class: 'rounded-lg py-2 px-5 bg-[#FF3F01] text-white inline-block font-medium cursor-pointer' %>
    </div>
    <div class="my-4 px-6 py-8 bg-white rounded-lg">
      <label class="font-medium">Name</label>
      <%= form.text_field :name, class: 'block rounded-md border border-gray-400 outline-none px-3 py-2 mt-2 w-full' %>
    </div>
    <div class="my-4 px-6 py-3 bg-white rounded-lg flex justify-between items-center">
      <label class="font-medium">Type of request</label>
      <%= form.select :type, options_for_select(item_kind_options, item.kind), {}, class: 'border-transparent focus:border-transparent focus:ring-0 pl-3 py-2 mt-2' %>
    </div>
    <div class="my-4 px-6 py-3 bg-white rounded-lg flex justify-between items-center">
      <label class="font-medium">Points</label>
      <%= form.select :points, options_for_select([['Unestimated', 0], 1, 2, 3, 5, 8], item.points), {}, class: 'border-transparent focus:border-transparent focus:ring-0 pl-3 py-2 mt-2 text-right' %>
    </div>
    <div class="my-4 px-6 py-8 bg-white rounded-lg">
      <%= form.label :description %>
      <%= form.text_area :description, rows: 4, class: 'block rounded-md border border-gray-400 outline-none px-3 py-2 mt-2 w-full' %>
    </div>
  <% end %>
</div>
