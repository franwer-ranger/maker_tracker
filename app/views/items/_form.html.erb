<div id="item-form" class="bg-[#F1F1F1] text-black w-full text-xs rounded-lg px-4 pt-1 pb-8">
  <%= form_with(model: [project, item], class: 'w-full', html: { "data-turbo-frame": '_top' }) do |form| %>
    <div class="flex justify-between my-4 items-center">
      <%= link_to 'Cancel', item.persisted? ? [project, item] : project, class: 'mx-2 underline text-sm' %>
      <%= form.submit 'Save', class: 'rounded-lg py-2 px-5 bg-[#FF3F01] text-white inline-block font-medium cursor-pointer' %>
    </div>
    <div class="my-4 px-4 py-2 bg-white rounded-lg">
      <label class="font-medium">Name</label>
      <%= form.text_field :name, class: 'block rounded-md border border-gray-400 text-xs outline-none focus:outline-none focus:ring-0 px-3 py-1 mt-1 w-full' %>
    </div>
    <div class="my-4 px-6 py-1 bg-white rounded-lg">
      <div class="flex justify-between items-center border-b border-gray-200 py-2">
        <label class="font-medium">Type of request</label>
        <%= form.select :kind, options_for_select(item_kind_options, item.kind), {}, class: 'text-right text-xs rounded border-transparent focus:border-transparent focus:ring-0 pl-2 py-1' %>
      </div>
      <% if item.persisted? %>
        <div class="py-2 border-b border-gray-200">
          <div class="flex justify-between items-center">
            <label class="font-medium">State</label>
            <%= form.select :status, options_for_select(item_status_options, item.status), {}, class: 'text-right text-xs rounded border-transparent focus:border-transparent focus:ring-0 pl-2 py-1' %>
          </div>
          <% if item.accepted? %>
            <div class="flex justify-end w-full pb-4">
              <%= form.date_field :accepted_at, class: 'rounded' %>
            </div>
          <% end %>
        </div>
      <% end %>
      <div class="flex justify-between items-center py-2 border-b border-gray-200">
        <label class="font-medium">Points</label>
        <%= form.select :points, options_for_select([0, 1, 2, 3, 5, 8], item.points), { prompt: 'Unstimated' }, class: 'text-right text-xs rounded border-transparent focus:border-transparent focus:ring-0 pl-2 py-1' %>
      </div>
      <div class="flex justify-between items-center py-2 border-b border-gray-200">
        <label class="font-medium">Owner</label>
        <%= form.select :user_id, options_for_select(users_options(@users), item.user), { prompt: 'Unassigned' }, class: 'text-right text-xs rounded border-transparent focus:border-transparent focus:ring-0 pl-2 py-1 max-w-36' %>
      </div>
      <div class="py-2">
        <%= form.label :description %>
        <%= form.text_area :description, rows: 4, class: 'block rounded-md border border-gray-400 outline-none px-3 py-2 mt-2 w-full' %>
      </div>
    </div>
  <% end %>
  <%= render 'activity', item: item, project: project %>
</div>
