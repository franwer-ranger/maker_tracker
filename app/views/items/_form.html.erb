<div id="item-form" class="bg-[#F1F1F1] text-black w-full text-sm rounded-lg px-4 pt-1 pb-8">
  <%= form_with(model: [project, item], class: 'w-full', html: { "data-turbo-frame": '_top' }) do |form| %>
    <div class="flex justify-end my-1 items-center w-full gap-1">
      <%= form.submit 'Save', class: 'rounded-lg py-2 px-3 bg-[#FF3F01] text-white inline-block font-medium cursor-pointer' %>
      <%= link_to 'Close', item.persisted? ? [project, item] : project, class: 'rounded-lg py-2 px-3 border border-[#FF3F01] text-[#FF3F01] inline-block font-medium cursor-pointer' %>
    </div>

    <label class="font-medium my-3">Name</label>
    <%= form.text_field :name, class: 'block rounded-md border border-gray-400 text-sm outline-none focus:outline-none focus:ring-0 px-3 py-2 mt-1 w-full' %>

    <div class="my-4 pl-4 pr-2 py-1 bg-white rounded-lg w-4/5">
      <div class="flex justify-between items-center border-b border-gray-200 py-1">
        <label class="font-medium">Type of request</label>
        <%= form.select :kind, options_for_select(item_kind_options, item.kind), {}, class: 'text-right text-sm rounded border-transparent focus:border-transparent focus:ring-0 pl-2 py-1' %>
      </div>
      <% if item.persisted? %>
        <div class="py-1 border-b border-gray-200">
          <div class="flex justify-between items-center">
            <label class="font-medium">State</label>
            <%= form.select :status, options_for_select(item_status_options, item.status), {}, class: 'text-right text-sm rounded border-transparent focus:border-transparent focus:ring-0 pl-2 py-1' %>
          </div>
          <% if item.accepted? %>
            <div class="flex justify-end w-full pb-4">
              <%= form.date_field :accepted_at, class: 'rounded' %>
            </div>
          <% end %>
        </div>
      <% end %>
      <div class="flex justify-between items-center py-1 border-b border-gray-200">
        <label class="font-medium">Points</label>
        <%= form.select :points, options_for_select([0, 1, 2, 3, 5, 8], item.points), { prompt: 'Unstimated' }, class: 'text-right text-sm rounded border-transparent focus:border-transparent focus:ring-0 pl-2 py-1' %>
      </div>
      <div class="flex justify-between items-center py-1">
        <label class="font-medium">Owner</label>
        <%= form.select :user_id, options_for_select(users_options(@users), item.user&.id), { prompt: 'Unassigned' }, class: 'text-right text-sm rounded border-transparent focus:border-transparent focus:ring-0 pl-2 py-1' %>
      </div>
    </div>
    <%= render 'description', form: form, item: item %>
  <% end %>
  <%= render 'activity', project: project, item: item %>
</div>
