<div id="<%= dom_id item %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Status:</strong>
    <%= item.status %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Kind:</strong>
    <%= item.kind %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Icebox:</strong>
    <%= item.icebox %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Name:</strong>
    <%= item.name %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Description:</strong>
    <%= item.description %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Points:</strong>
    <%= item.points %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">User:</strong>
    <%= item.user_id %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Sprint:</strong>
    <%= item.sprint_id %>
  </p>

  <% if action_name != "show" %>
    <%= link_to "Show this item", item, class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
    <%= link_to "Edit this item", edit_item_path(item), class: "rounded-lg py-3 ml-2 px-5 bg-gray-100 inline-block font-medium" %>
    <hr class="mt-6">
  <% end %>
</div>
