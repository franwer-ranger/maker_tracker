<div id="<%= dom_id item %>" class="w-full flex items-center justify-between px-3 py-4 border border-gray-800 bg-gray-900 rounded">
  <div class="flex">
    <div class="mr-3"><%= item.format_kind_icon %></div>
    <div class="name"><%= item.name %></div>
  </div>
  <div class="flex">
    <div class="p-1 font-bold">0</div>
    <div class="p-1 font-bold">1</div>
    <div class="p-1 font-bold">2</div>
    <div class="p-1 font-bold">3</div>
    <div class="p-1 font-bold">5</div>
    <div class="p-1 font-bold">8</div>
  </div>
</div>
