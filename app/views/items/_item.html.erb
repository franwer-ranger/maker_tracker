<turbo-frame class="item" id="item" data-item-id="<%= item.id %>" data-controller="items">
  <%= link_to edit_project_item_path(item.project, item), id: dom_id(item), "data-turbo-prefetch": 'false', class: "w-full flex items-center justify-between px-2 border border-gray-800 #{item_status_bg(item)} #{item.accepted? ? 'py-3' : 'cursor-move rounded py-4'}" do %>
    <%= form_with(url: item_state_path(item), class: 'hidden', method: :put, html: { "data-items-target": 'itemStateForm', "data-turbo-frame": '_top' }) do |form| %>
      <%= form.hidden_field :state, "data-items-target": 'state' %>
    <% end %>
    <%= form_with(model: [item.project, item], class: 'hidden', html: { "data-items-target": 'itemForm', "data-turbo-frame": '_top' }) do |form| %>
      <%= form.hidden_field :points, "data-items-target": 'points' %>
      <%= form.hidden_field :position, "data-items-target": 'position' %>
      <%= form.hidden_field :sprint_id, "data-items-target": 'sprintId' %>
      <%= form.hidden_field :user_id, "data-items-target": 'userId' %>
    <% end %>
    <div class="flex items-center flex-grow">
      <div class="mr-2 text-xs"><%= item.format_kind_icon %></div>
      <% if item.points %>
        <div class="py-1 px-2 rounded font-bold mr-4 border border-gray-800 text-xs"><%= item.points %></div>
      <% end %>
      <div class="text-sm <%= item.points ? '' : 'italic' %>"><%= item.name %></div>
      <% if item.user %>
        <div class="text-sm mx-1 <%= item.points ? '' : 'italic' %>">(<%= item.user.nickname %>)</div>
      <% end %>
    </div>
    <% if item.points %>
      <% if item.delivered? %>
        <div class="flex flex-1 gap-1">
          <button data-item-id="<%= item.id %>" data-action="items#accept" class="bg-green-600 text-white border border-gray-800 p-2 rounded text-xs font-semibold">
            Accept
          </button>
          <button data-item-id="<%= item.id %>" data-action="items#reject" class="bg-red-600 text-white border border-gray-800 p-2 rounded text-xs font-semibold">
            Reject
          </button>
        </div>
      <% elsif item.accepted? %>
        <div class="text-xs mx-3 font-light"><%= item.accepted_at.strftime('%a %d %B') %></div>
      <% else %>
        <button data-item-id="<%= item.id %>" data-status="<%= item.status %>" data-action="items#changeStatus" class="<%= item_button_styles(item) %> mx-3 border border-gray-800 px-3 py-2 rounded text-xs font-semibold">
          <%= item_button_caption(item) %>
        </button>
      <% end %>
    <% else %>
      <div class="flex">
        <button data-points="0" data-action="items#changePoints" class="py-1 px-2 text-xs rounded font-bold mr-1 border border-gray-800 text-white">0</button>
        <button data-points="1" data-action="items#changePoints" class="py-1 px-2 text-xs rounded font-bold mr-1 border border-gray-800 text-white">1</button>
        <button data-points="2" data-action="items#changePoints" class="py-1 px-2 text-xs rounded font-bold mr-1 border border-gray-800 text-white">2</button>
        <button data-points="3" data-action="items#changePoints" class="py-1 px-2 text-xs rounded font-bold mr-1 border border-gray-800 text-white">3</button>
        <button data-points="5" data-action="items#changePoints" class="py-1 px-2 text-xs rounded font-bold mr-1 border border-gray-800 text-white">5</button>
        <button data-points="8" data-action="items#changePoints" class="py-1 px-2 text-xs rounded font-bold mr-1 border border-gray-800 text-white">8</button>
      </div>
    <% end %>
  <% end %>
</turbo-frame>
