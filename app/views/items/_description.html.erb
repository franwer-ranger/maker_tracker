<div class="my-3" data-controller="items--description" data-items--description-content-value="<%= item.description %>">
  <div data-items--description-target="preview" class="<%= item.description.blank? ? 'hidden' : '' %>">
    <%= render 'items/description/header', label: 'Edit', item: item %>
    <div class="mb-2 bg-white rounded p-4">
      <div data-items--description-target="markdown text-sm"><%= item.description %></div>
    </div>
  </div>
  <div data-items--description-target="field" class="<%= item.description.blank? ? '' : 'hidden' %>">
    <%= render 'items/description/header', label: 'Preview', item: item %>
    <%= form.text_area :description, rows: 4, class: 'block rounded-md border border-gray-400 outline-none px-3 py-2 mt-2 w-full text-sm', 'data-action': 'input->items--description#change' %>
  </div>
</div>
