<%# Cabecera de proyecto del móvil (5.0 · Selector · Móvil, MT-45): clave + nombre + chevron; al pulsarla, la hoja con los proyectos. En escritorio no sale: el proyecto está en la barra lateral. Locals: project, action (opcional, a la derecha, p. ej. «Editar» en el Brief). %>
<div class="-mx-4 flex h-[52px] shrink-0 items-center justify-between self-stretch pl-2 pr-4 md:hidden">
  <%= ui_menu sheet: "Proyectos", summary: capture { %>
    <span class="flex h-11 items-center gap-2.5 px-2">
      <%= project_key_badge project, size: 28 %>
      <span class="text-[15px] font-semibold leading-5 text-text"><%= project.name %></span>
      <%= icon "chevron-up-down", size: 14, class: "text-text-muted" %>
    </span>
  <% } do %>
    <% Project.order(:created_at).each do |other| %>
      <%= link_to project_path(other), aria: { current: ("page" if other == project) },
            class: class_names("flex h-[60px] shrink-0 items-center gap-3 rounded-lg px-3 #{ComponentsHelper::FOCUS_RING}", "bg-border-strong": other == project) do %>
        <%= project_key_badge other %>
        <span class="flex min-w-0 grow basis-0 flex-col gap-0.5">
          <span class="truncate text-[15px] font-medium leading-5 text-text"><%= other.name %></span>
          <span class="truncate text-control text-text-muted"><%= other.current_milestone ? milestone_label(other.current_milestone) : "Sin hitos abiertos" %></span>
        </span>
        <%= project_activity other %>
      <% end %>
    <% end %>
    <div class="my-1 h-px shrink-0 bg-border-strong"></div>
    <%= link_to projects_path, class: "flex h-[52px] shrink-0 items-center gap-3 rounded-lg px-3 #{ComponentsHelper::FOCUS_RING}" do %>
      <span class="flex w-8 shrink-0 justify-center text-text-muted"><%= icon "plus", size: 16 %></span>
      <span class="grow text-[15px] leading-5 text-text">Nuevo proyecto</span>
      <span class="font-mono text-xs text-text-muted">mt project create</span>
    <% end %>
  <% end %>
  <%= local_assigns[:action] %>
</div>
