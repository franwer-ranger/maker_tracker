<%# Aviso de conflicto al guardar (7.5). Locals: conflict (EditConflict), form_id, discard_path. Los botones envían el formulario de la edición.
    En el móvil (7.5 · Móvil) va arriba, antes del título; quién y cuándo, debajo de cada cambio, y las tres acciones apiladas a todo el ancho. %>
<% mobile_action = "max-md:h-11 max-md:w-full max-md:text-[15px] max-md:leading-5" %>
<section class="flex flex-col gap-3.5 rounded-xl border border-strong bg-surface-sunken p-4" role="alert">
  <div class="flex items-start gap-3">
    <%= icon "exclamation-triangle", size: 20, class: "mt-px shrink-0 text-state-defining" %>
    <div class="flex flex-col gap-1">
      <p class="text-sm font-medium leading-5 text-text max-md:text-[15px]">No se ha guardado: cambió mientras la editabas</p>
      <p class="text-control leading-[18px] text-text-muted">Tu texto sigue aquí, no se ha perdido nada. Mira qué cambió y decide.</p>
    </div>
  </div>

  <% if conflict.rows.any? %>
    <ul class="flex flex-col gap-1.5 py-2.5 pl-11 pr-3 max-md:gap-2 max-md:p-0 max-md:pl-8">
      <% conflict.rows.each_with_index do |row, index| %>
        <li class="flex gap-2.5">
          <span class="w-4 shrink-0 font-mono text-xs leading-[18px] <%= row.mark == '+' ? 'text-state-done' : 'text-text-muted' %>" aria-hidden="true"><%= row.mark %></span>
          <span class="flex min-w-0 grow basis-0 flex-col gap-0.5">
            <span class="text-control leading-[18px] text-text-soft max-md:text-sm max-md:leading-[18px]"><%= row.text %></span>
            <% if conflict.editor %>
              <span class="font-mono text-xs text-text-muted md:hidden"><%= conflict.editor.name %><%= " · #{l(conflict.edited_at.localtime, format: '%H:%M')}" if conflict.edited_at %></span>
            <% end %>
          </span>
          <% if index.zero? && conflict.editor %>
            <span class="hidden shrink-0 font-mono text-xs leading-[18px] text-text-muted md:inline"><%= conflict.editor.name %><%= " · #{l(conflict.edited_at.localtime, format: '%H:%M')}" if conflict.edited_at %></span>
          <% end %>
        </li>
      <% end %>
      <% if conflict.more.positive? %>
        <li class="pl-[26px] text-control leading-[18px] text-text-muted max-md:text-sm">… y <%= conflict.more %> cambios más</li>
      <% end %>
    </ul>
  <% end %>

  <% if conflict.clashes.any? %>
    <p class="pl-11 pr-3 text-control leading-[18px] text-state-defining max-md:px-0" role="status">
      Los dos habéis cambiado (<%= conflict.clashes.map { conflict.labels[it].downcase }.join(", ") %>): si traes sus cambios, ahí se queda lo tuyo.
    </p>
  <% end %>

  <%# Ver las dos versiones y las acciones; en el móvil, apiladas: traer, ver, descartar. %>
  <div class="flex flex-col gap-3.5 max-md:gap-2">
    <% if conflict.differing.any? %>
      <details class="group pl-11 pr-3 max-md:order-2 max-md:p-0">
        <summary class="flex h-8 w-fit cursor-pointer list-none items-center rounded-md border border-strong px-3 text-control text-text hover:bg-surface [&::-webkit-details-marker]:hidden <%= ComponentsHelper::FOCUS_RING %> max-md:h-11 max-md:w-full max-md:justify-center max-md:text-[15px] max-md:leading-5">Ver las dos versiones</summary>
        <div class="mt-3 flex flex-col gap-4">
          <% conflict.differing.each do |field| %>
            <div class="flex flex-col gap-2">
              <p class="font-mono text-xs uppercase tracking-label text-text-muted"><%= conflict.labels[field] %></p>
              <div class="grid gap-3 md:grid-cols-2">
                <div class="flex min-w-0 flex-col gap-1.5">
                  <span class="text-control text-text-muted">Suya<%= " · #{conflict.editor.name}" if conflict.editor %></span>
                  <pre class="whitespace-pre-wrap break-words rounded-md border border-border bg-bg p-3 font-mono text-control leading-5 text-text-soft"><%= conflict.theirs[field].presence || "—" %></pre>
                </div>
                <div class="flex min-w-0 flex-col gap-1.5">
                  <span class="text-control text-text-muted">Tuya</span>
                  <pre class="whitespace-pre-wrap break-words rounded-md border border-border bg-bg p-3 font-mono text-control leading-5 text-text-soft"><%= conflict.mine[field].presence || "—" %></pre>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </details>
    <% end %>

    <div class="flex flex-wrap items-center justify-end gap-2 max-md:contents">
      <%= ui_button "Descartar lo mío", variant: :ghost, size: :sm, href: discard_path, data: { turbo: false }, class: "max-md:order-3 #{mobile_action}" %>
      <%= ui_button "Traer sus cambios y seguir", type: "submit", name: "resolve", value: "bring", form: form_id, size: :sm, class: "max-md:order-1 #{mobile_action}" %>
    </div>
  </div>
</section>
