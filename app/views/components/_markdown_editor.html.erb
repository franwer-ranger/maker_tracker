<%# Editor de markdown con pestañas Escribir / Vista previa (5.6). Locals: form, attribute, label, doc (variante documento),
    upload_url (opcional: pegar o arrastrar archivos los sube ahí y deja su enlace, MT-96) %>
<% upload_url = local_assigns[:upload_url] %>
<%= tag.div class: "flex flex-col rounded-lg border border-strong bg-surface-sunken focus-within:shadow-[0_0_0_3px_color-mix(in_srgb,var(--color-text)_12%,transparent)]",
      data: { controller: class_names("markdown editor", upload: upload_url), upload_url_value: upload_url }.compact do %>
  <div class="flex h-control shrink-0 items-center justify-between border-b border-border pl-2 pr-3" role="tablist">
    <div class="flex gap-0.5">
      <button type="button" role="tab" data-editor-target="tab" data-action="editor#write" aria-selected="true"
              class="flex h-7 items-center rounded-md px-2.5 text-control text-text-muted aria-selected:bg-surface aria-selected:font-medium aria-selected:text-text <%= ComponentsHelper::FOCUS_RING %> <%= ComponentsHelper::TOUCH_TARGET %>">Escribir</button>
      <button type="button" role="tab" data-editor-target="tab" data-action="editor#preview markdown#render" aria-selected="false"
              class="flex h-7 items-center rounded-md px-2.5 text-control text-text-muted aria-selected:bg-surface aria-selected:font-medium aria-selected:text-text <%= ComponentsHelper::FOCUS_RING %> <%= ComponentsHelper::TOUCH_TARGET %>">Vista previa</button>
    </div>
    <span class="font-mono text-xs text-text-subtle"><%= upload_url ? "markdown · pega o arrastra archivos" : "markdown" %></span>
  </div>
  <%= form.text_area attribute, rows: 18, "aria-label": label,
        data: { markdown_target: "source", editor_target: "input", upload_target: ("input" if upload_url), action: ("paste->upload#paste dragover->upload#dragover drop->upload#drop" if upload_url) }.compact,
        class: "min-h-96 w-full resize-y border-0 bg-transparent p-4 [field-sizing:content] font-mono text-control leading-[22px] text-text-soft focus:outline-hidden focus:ring-0" %>
  <div class="<%= class_names("markdown hidden p-4", "markdown-doc": local_assigns[:doc]) %>" data-markdown-target="output" data-editor-target="preview"></div>
  <% if upload_url %>
    <p class="hidden border-t border-border px-4 py-2 text-control text-state-defining" role="status" data-upload-target="status"></p>
  <% end %>
<% end %>
