<div class="text-sm text-white bg-black w-full px-4 py-2 flex items-center justify-between no-sort">
  <div class="flex items-center">
    <div class="py-1 px-2 text-xs rounded font-bold mr-1 border border-gray-800 text-white">
      S<%= sprint.number %>
    </div>
    <% if sprint.current? %>
      <div class="relative cursor-pointer text-white" data-controller="override">
        <div
          class="py-1 px-2 text-xs rounded font-bold mr-1 border border-gray-800 <%= sprint.project.velocity_overrided? ? 'text-red-500' : '' %> "
          data-action="click->override#toggle">
          <%= sprint.project.velocity_with_override %> points
        </div>
        <%= form_with(model: sprint.project, class: 'absolute top-10 left-0 z-30 flex gap-2 bg-[#F1F1F1] p-4 rounded hidden', html: { 'data-override-target': 'form', "data-turbo-frame": '_top' }) do |form| %>
          <%= form.number_field :velocity_override, class: 'rounded-md border border-gray-400 outline-none px-3 py-2 w-20', min: '0' %>
          <%= form.submit 'override', class: 'rounded-lg py-2 px-3 bg-[#FF3F01] text-white font-medium inline-block cursor-pointer' %>
        <% end %>
      </div>
    <% elsif sprint.past? %>
      <div class="py-1 px-2 text-xs rounded font-bold mr-1 border border-gray-800 text-green-100">
        <%= sprint.current_velocity %> points
      </div>
    <% end %>
  </div>
  <%= sprint_dates(sprint) %>
</div>
