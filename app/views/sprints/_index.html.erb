<turbo-frame id="sprints">
  <% if sprints.empty? %>
    <div class="flex-grow flex justify-center items-center">
      <div class="flex flex-col items-center">
        <%= image_tag 'done_empty.svg', class: 'h-60' %>
        <div class="text-xs font-thin my-4">
          No items have been completed yet.
        </div>
      </div>
    </div>
  <% else %>
    <div class="flex flex-col w-full h-full overflow-y-auto" data-projects-target="done">
        <% sprints.each do |sprint| %>
          <div class="text-sm text-white bg-black w-full px-4 py-2 flex items-center justify-between">
            <div class="py-1 px-2 text-xs rounded font-bold mr-1 border border-gray-800 text-white">
              S<%= sprint.number %>
            </div>
            <%= sprint_dates(sprint) %>
          </div>
          <div class="flex flex-col gap-1" data-projects-target="items">
            <% sprint.items.order(order_items).each do |item| %>
              <%= render item %>
            <% end %>
          </div>
        <% end %>
    </div>
  <% end %>
</turbo-frame>
