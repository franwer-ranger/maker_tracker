<!DOCTYPE html>
<html>
  <head>
    <title>Marker Tracker</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag 'tailwind', "data-turbo-track": 'reload' %>

    <%= stylesheet_link_tag 'application', "data-turbo-track": 'reload' %>
    <%= javascript_importmap_tags %>
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
    <%= yield :meta %>
  </head>

  <body class="bg-bg font-sans text-text">
    <div class="flex items-center px-4 app-header justify-between">
      <div class="flex gap-4 items-center">
        <%= link_to projects_path do %>
          <%= image_tag 'isotype.svg', class: 'h-10' %>
        <% end %>
        <%= yield :project_info %>
      </div>
      <% if current_user %>
        <div class="flex">
          <%= current_user.full_name %>
          <%= button_to(
                '(Sign out)',
                destroy_user_session_path,
                class: 'text-white underline ml-1 text-sm',
                method: :delete
              ) %>
        </div>
      <% end %>
    </div>
    <main class="app-container w-full flex flex-col">
      <%= yield %>
    </main>
  </body>
</html>
