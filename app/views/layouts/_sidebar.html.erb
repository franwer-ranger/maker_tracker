<aside class="flex h-full w-[232px] shrink-0 flex-col justify-between border-r border-border px-4 py-6">
  <div class="flex flex-col gap-8">
    <%= ui_menu summary: capture { %>
      <span class="flex items-center gap-3 px-2">
        <%= project_key_badge project %>
        <span class="flex grow flex-col gap-0.5">
          <span class="text-sm font-semibold leading-[18px] text-text"><%= project.name %></span>
          <span class="text-xs text-text-muted">Maker Tracker</span>
        </span>
        <%= icon "chevron-up-down", size: 16, class: "text-text-muted" %>
      </span>
    <% }, width: "w-60" do %>
      <% Project.order(:created_at).each do |other| %>
        <%= menu_item other.name, project_path(other), code: other.key, active: other == project %>
      <% end %>
      <%= menu_separator %>
      <%= menu_item "Todos los proyectos", projects_path %>
    <% end %>

    <nav class="flex flex-col gap-0.5" aria-label="Secciones del proyecto">
      <%= nav_item "Tablero", project_path(project) %>
      <%= nav_item "Roadmap", project_roadmap_path(project) %>
      <%= nav_item "Brief", project_brief_path(project) %>
    </nav>
  </div>

  <% agents = Actor.agent.order(:name) %>
  <% if agents.any? %>
    <div class="flex flex-col gap-3.5 px-2">
      <%= section_label "Agentes" %>
      <% agents.each do |agent| %>
        <%= agent_status project, agent %>
      <% end %>
    </div>
  <% end %>
</aside>
