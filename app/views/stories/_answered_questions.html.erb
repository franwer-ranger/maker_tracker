<%# Preguntas respondidas (5.10b): al final de la historia, sin naranja. Salen de la tabla `questions`, no del cuerpo. Local: story. %>
<% questions = story.answered_questions %>
<% if questions.any? %>
  <section id="preguntas" class="flex flex-col gap-3.5">
    <%= section_label "Preguntas · #{questions.size} #{questions.one? ? "respondida" : "respondidas"}" %>
    <% questions.each do |question| %>
      <article class="flex flex-col gap-2.5 rounded-xl border border-border px-6 py-5 max-md:p-4">
        <div class="flex items-center justify-between gap-3">
          <span class="font-mono text-xs text-text-muted"><%= question.actor.name %> preguntó · <%= relative_day(question.created_at, time_of_day: true) %></span>
          <%= question_reversibility question %>
        </div>
        <h3 class="text-base font-medium"><%= question.title %></h3>
        <div class="flex flex-wrap items-center gap-3 pt-1">
          <span class="flex h-8 items-center gap-2 rounded-md bg-surface px-3 shadow-[inset_0_0_0_1px_var(--color-border-strong)]">
            <%= icon "check", size: 16, class: "text-state-done" %>
            <% if question.free_answer? %>
              <span class="text-control font-medium">Respuesta libre</span>
            <% else %>
              <span class="font-mono text-xs text-text-muted"><%= question.answer %></span>
              <span class="text-control font-medium"><%= question.answer_text %></span>
            <% end %>
          </span>
          <span class="font-mono text-xs text-text-muted">
            <%= question.answered_by.name %> · <%= relative_day(question.answered_at, time_of_day: true) %><%= " · la recomendada" if question.answer && question.answer == question.recommended %>
          </span>
        </div>
        <% if question.answer_note.present? %>
          <p class="text-sm text-text-soft">«<%= question.answer_note %>»</p>
        <% end %>
        <p class="text-control leading-[18px] text-text-subtle">Descartadas: <%= question.discarded_options.map { |number, text| "#{number} #{text}" }.join(" · ") %></p>
      </article>
    <% end %>
  </section>
<% end %>
