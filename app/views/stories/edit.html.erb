<% content_for :title, "Editar #{@story.reference}" %>
<%= form_with model: @story, url: project_story_path(@project, @story), method: :patch, id: "story-form",
      class: "flex items-start gap-16 px-12 py-10" do |form| %>
  <div class="flex min-w-0 grow basis-0 flex-col gap-5">
    <%= render "stories/breadcrumb", story: @story %>

    <%= form.text_field :title, required: true, "aria-label": "Título",
          class: "h-[52px] w-full rounded-md border border-strong bg-surface-sunken px-3.5 text-2xl font-semibold leading-[30px] tracking-[-0.01em] text-text focus:border-strong focus:outline-none focus:ring-0 focus:shadow-[0_0_0_3px_color-mix(in_srgb,var(--color-text)_12%,transparent)]" %>

    <div class="flex flex-col rounded-lg border border-strong bg-surface-sunken focus-within:shadow-[0_0_0_3px_color-mix(in_srgb,var(--color-text)_12%,transparent)]"
         data-controller="markdown editor">
      <div class="flex h-control shrink-0 items-center justify-between border-b border-border pl-2 pr-3" role="tablist">
        <div class="flex gap-0.5">
          <button type="button" role="tab" data-editor-target="tab" data-action="editor#write" aria-selected="true"
                  class="flex h-7 items-center rounded-md px-2.5 text-control text-text-muted aria-selected:bg-surface aria-selected:font-medium aria-selected:text-text <%= ComponentsHelper::FOCUS_RING %>">Escribir</button>
          <button type="button" role="tab" data-editor-target="tab" data-action="editor#preview markdown#render" aria-selected="false"
                  class="flex h-7 items-center rounded-md px-2.5 text-control text-text-muted aria-selected:bg-surface aria-selected:font-medium aria-selected:text-text <%= ComponentsHelper::FOCUS_RING %>">Vista previa</button>
        </div>
        <span class="font-mono text-xs text-text-subtle">markdown</span>
      </div>
      <%= form.text_area :body, rows: 18, "aria-label": "Cuerpo en markdown", data: { markdown_target: "source", editor_target: "input" },
            class: "min-h-96 w-full resize-y border-0 bg-transparent p-4 [field-sizing:content] font-mono text-control leading-[22px] text-text-soft focus:outline-none focus:ring-0" %>
      <div class="markdown hidden p-4" data-markdown-target="output" data-editor-target="preview"></div>
    </div>

    <div class="flex items-center justify-end gap-2">
      <span class="grow font-mono text-xs text-text-subtle">Se guarda como <%= Current.actor.name %> · queda en el historial</span>
      <%= ui_button "Cancelar", variant: :ghost, href: project_story_path(@project, @story) %>
      <%= ui_button "Guardar", type: "submit" %>
    </div>
  </div>

  <%= render "stories/aside", story: @story, form: form %>
<% end %>
