<% content_for :title, "Editar #{@story.reference}" %>
<%= form_with model: @story, url: project_story_path(@project, @story), method: :patch, id: "story-form",
      class: "flex items-start gap-16 px-12 py-10" do |form| %>
  <div class="flex min-w-0 grow basis-0 flex-col gap-5">
    <%= render "stories/breadcrumb", story: @story %>

    <%= form.text_field :title, required: true, "aria-label": "Título",
          class: "h-[52px] w-full rounded-md border border-strong bg-surface-sunken px-3.5 text-2xl font-semibold leading-[30px] tracking-[-0.01em] text-text focus:border-strong focus:outline-none focus:ring-0 focus:shadow-[0_0_0_3px_color-mix(in_srgb,var(--color-text)_12%,transparent)]" %>

    <%= render "components/markdown_editor", form: form, attribute: :body, label: "Cuerpo en markdown" %>

    <div class="flex items-center justify-end gap-2">
      <span class="grow font-mono text-xs text-text-subtle">Se guarda como <%= Current.actor.name %> · queda en el historial</span>
      <%= ui_button "Cancelar", variant: :ghost, href: project_story_path(@project, @story) %>
      <%= ui_button "Guardar", type: "submit" %>
    </div>
  </div>

  <%= render "stories/aside", story: @story, form: form %>
<% end %>
