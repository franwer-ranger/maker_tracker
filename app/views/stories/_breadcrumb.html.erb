<nav class="flex items-center gap-2 text-control" aria-label="Miga de pan">
  <%= link_to "Roadmap", project_roadmap_path(@project), class: "rounded-sm text-text-muted hover:text-text #{ComponentsHelper::FOCUS_RING}" %>
  <span class="text-text-subtle">/</span>
  <% if story.milestone %>
    <%= link_to milestone_label(story.milestone), project_path(@project, hito: story.milestone.position),
          class: "rounded-sm text-text-muted hover:text-text #{ComponentsHelper::FOCUS_RING}" %>
  <% else %>
    <%= link_to "Bandeja de ideas", project_path(@project, hito: "ideas"), class: "rounded-sm text-text-muted hover:text-text #{ComponentsHelper::FOCUS_RING}" %>
  <% end %>
  <span class="text-text-subtle">/</span>
  <span class="font-mono text-text" aria-current="page"><%= story.reference %></span>
</nav>
