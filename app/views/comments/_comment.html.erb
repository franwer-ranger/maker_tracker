<%= turbo_frame_tag dom_id(comment), class: 'block last:border-none border-b border-gray-200' do %>
  <% if comment.persisted? %>
    <div class="flex items-center px-1 py-2 gap-2">
      <div class="bg-gray-300 rounded-full leading-none w-9 h-9 text-xs font-medium flex justify-center items-center">
        <%= comment.user.initials_safe %>
      </div>

      <div class="text-xs p-1 flex-grow">
        <div class="font-semibold">
          <%= "@#{comment.user.username}" %>
        </div>
        <div class="my-2">
          <%= comment.content %>
        </div>
        <div class="flex items-center gap-2">
          <div class="text-gray-500">
            <%= comment.created_at.strftime('%d %b %Y, %I:%M%P') %>
          </div>
          <%= link_to 'Edit', edit_project_item_comment_path(comment, project_id: project.id, item_id: item.id), class: 'btn btn--light' %>
          <%= button_to 'Delete', project_item_comment_path(comment, item_id: item.id, project_id: project.id), method: :delete, class: 'btn btn--light' %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
