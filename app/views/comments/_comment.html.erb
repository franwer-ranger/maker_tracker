<%= turbo_frame_tag dom_id(comment) do %>
  <% if comment.persisted? %>
    <div class="flex items-center py-2 border-b border-gray-200">
      <div class="flex items-center flex-grow">
        <div class="mr-2 text-xs"><%= comment.user.nickname %></div>
        <div class="text-xs"><%= comment.content %></div>
      </div>
      <div class="flex items-center justify-center gap-2">
        <%= link_to 'Edit', edit_project_item_comment_path(comment, project_id: project.id, item_id: item.id), class: 'btn btn--light' %>
        <%= button_to 'Delete', project_item_comment_path(comment, item_id: item.id, project_id: project.id), method: :delete, class: 'btn btn--light' %>
      </div>
    </div>
  <% end %>
<% end %>
