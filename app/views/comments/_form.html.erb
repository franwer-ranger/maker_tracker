<%= turbo_frame_tag "comment_#{comment.id}" do %>
  <%= form_with(model: [project, item, comment], class: 'w-full', html: { "data-turbo-frame": '_top' }) do |form| %>
    <div class="flex py-1 gap-2">
      <div class="bg-gray-300 rounded-full leading-none w-9 h-9 text-xs font-medium flex justify-center items-center">
        <%= current_user.initials_safe %>
      </div>
      <%= form.text_area :content, rows: 3, class: 'block text-xs rounded-md border-transparent focus:border-transparent focus:ring-0 outline-none px-3 py-2 flex-grow text-sm' %>
    </div>
    <div class="flex items-center py-2 justify-end">
      <%= form.submit 'Post Comment', class: 'rounded-lg py-2 px-3 text-xs font-medium bg-[#FF3F01] text-white inline-block cursor-pointer' %>
    </div>
  <% end %>
<% end %>
