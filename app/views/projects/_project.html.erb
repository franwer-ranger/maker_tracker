<div id="<%= dom_id project %>" class="bg-[#1D1D1D] text-white p-4 rounded-lg">
  <div class="flex justify-between my-2">
    <%= link_to project, class: 'font-semibold text-lg' do %>
      <%= project.name %>
    <% end %>
    <div class="font-semibold text-lg">
      <%= link_to edit_project_path(project), class: 'font-semibold text-lg' do %>
        <i class="fa-solid fa-gear"></i>
      <% end %>
    </div>
  </div>
  <hr>

  <div class="flex gap-1 my-4">
    <div>Velocity</div>
    <div class="font-semibold"><%= project.velocity %></div>
  </div>

  <div class="flex gap-1 my-4">
    <div>Volatility</div>
    <div class="font-semibold"><%= project.volatility || '0%' %></div>
  </div>
</div>
