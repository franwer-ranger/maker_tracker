<turbo-frame id="icebox" class="relative flex h-[calc(100%-30px)] w-full items-start">
  <%= link_to new_project_item_path(project), class: 'absolute -top-10 right-8 text-accent', aria: { label: 'New item' } do %>
    <%= icon "plus" %>
  <% end %>
  <div class="flex flex-col w-full h-full gap-1 z-20" data-controller="icebox" data-icebox-items-outlet=".item" data-list="icebox">
    <%= render project.items.on_icebox.order(:position) %>
    <div class="hidden text-center text-sm italic border rounded p-3">💩sortablejs hack💩 https://github.com/SortableJS/Sortable/issues/1686#issuecomment-1240231903 </div>
  </div>
  <% if project.items.on_icebox.empty? %>
    <div class="absolute h-full w-full flex justify-center items-center">
      <div class="flex flex-col items-center">
        <%= image_tag 'icebox_empty.svg', class: 'h-60' %>
        <div class="text-xs font-thin my-4">
          No items have been added to the icebox yet.
        </div>
      </div>
    </div>
  <% end %>
</turbo-frame>
