<turbo-frame id="backlog" class="flex-1">
  <div class="relative flex flex-col w-full h-full">
    <div class="flex flex-col h-full gap-1 z-20" data-controller="backlog" data-backlog-items-outlet=".item" data-list="backlog">
      <% project.backlog.each do |backlog_item| %>
        <% if backlog_item[:type] == "item" %>
          <%= render backlog_item[:value] %>
        <% elsif backlog_item[:type] == "sprint" %>
          <%= render 'sprints/header', sprint: backlog_item[:value] %>
        <% end %>
      <% end %>
      <div class="hidden item-form text-center text-sm italic border rounded p-3">💩sortablejs hack💩 https://github.com/SortableJS/Sortable/issues/1686#issuecomment-1240231903 </div>
    </div>
    <% if project.items.on_backlog.empty? %>
      <div class="absolute h-full w-full flex justify-center items-center">
        <div class="flex flex-col items-center">
          <%= image_tag 'backlog_empty.svg', class: 'h-60' %>
          <div class="text-xs font-thin my-4">
            No items have been added to the backlog yet.
          </div>
        </div>
      </div>
    <% end %>
  </div>
</turbo-frame>
