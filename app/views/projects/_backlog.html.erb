<turbo-frame id="backlog">
  <div class="flex flex-col w-full h-full overflow-y-auto" data-projects-target="backlog">
    <%= render 'sprints/header', sprint: project.current_sprint %>
    <div class="flex flex-col gap-1" data-projects-target="items" data-list="backlog" data-sprint-id="<%= project.current_sprint.id %>">
      <% project.current_sprint.items.order(:position).each do |item| %>
        <%= render item %>
      <% end %>
    </div>
  </div>
</turbo-frame>
