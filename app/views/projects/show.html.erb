<div class="container mx-auto h-full xl:flex xl:justify-center">
  <turbo-frame id="project" class="flex gap-6 h-full" data-controller="projects" data-action="turbo:frame-load->projects#initSortable">
    <%= form_with(model: [@project, Item.new], url: project_item_path(@project, ':item'), method: :put, class: 'w-full', html: { "data-projects-target": 'form' }) do |form| %>
      <%= form.hidden_field :position, "data-projects-target": 'position' %>
      <%= form.hidden_field :position_changed, value: 'true' %>
    <% end %>
    <div class="bg-[#1D1D1D] rounded-lg h-full flex flex-col w-[28rem] grow-0 shrink-0">
      <div class="px-6 pt-6 pb-2">Done</div>
      <% if @project.sprints.empty? %>
        <div class="flex-grow flex justify-center items-center">
          <div class="flex flex-col items-center">
            <%= image_tag 'done_empty.svg', class: 'h-60' %>
            <div class="text-xs font-thin my-4">
              No items have been completed yet.
            </div>
          </div>
        </div>
      <% else %>
        <div class="flex flex-col w-full h-full overflow-y-auto gap-1" data-projects-target="done">
            <% @project.sprints.each do |sprint| %>
              <div class="text-sm text-white bg-black w-full px-4 py-3 flex items-center justify-between">
                <div class="py-1 px-2 text-xs rounded font-bold mr-1 border border-gray-800 text-white">
                  S<%= sprint.number %>
                </div>
                <%= sprint_dates(sprint) %>
              </div>
              <% sprint.items.accepted.each do |item| %>
                <%= render item %>
              <% end %>
            <% end %>
        </div>
      <% end %>
    </div>
    <div class="bg-[#1D1D1D] rounded-lg h-full p-6 flex flex-col w-[28rem] grow-0 shrink-0">
      <div class="">Backlog</div>
      <% if @project.items.on_backlog.empty? %>
        <div class="flex-grow flex justify-center items-center">
          <div class="flex flex-col items-center">
            <%= image_tag 'backlog_empty.svg', class: 'h-60' %>
            <div class="text-xs font-thin my-4">
              No items have been added to the backlog yet.
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="bg-[#1D1D1D] rounded-lg h-full py-6 px-5 flex flex-col w-[28rem] grow-0 shrink-0 relative">
      <div class="mb-2 h-[30px]">Icebox</div>
      <turbo-frame id="items" class="flex h-[calc(100%-30px)] w-full items-start">
        <%= link_to new_project_item_path(@project) do %>
          <i class="fa-solid fa-plus text-[#FF3F01] text-lg absolute top-7 right-8"></i>
        <% end %>
        <% if @project.items.on_icebox.empty? %>
          <div class="h-full w-full flex justify-center items-center">
            <div class="flex flex-col items-center">
              <%= image_tag 'icebox_empty.svg', class: 'h-60' %>
              <div class="text-xs font-thin my-4">
                No items have been added to the icebox yet.
              </div>
            </div>
          </div>
        <% else %>
          <div class="flex flex-col w-full h-full overflow-y-auto gap-2" data-projects-target="icebox">
            <%= render @project.items.order(:position) %>
          </div>
        <% end %>
      </turbo-frame>
    </div>
  </turbo-frame>
</div>
