<% content_for :meta do %>
    <meta name="current-user-id" content="<%= current_user.id %>">
    <meta name="current-project-id" content="<%= @project.id %>">
    <meta name="current-sprint-id" content="<%= @project.current_sprint.id %>">
<% end %>

<% content_for :project_info do %>
  <div class="text-xl font-semibold"><%= @project.name %></div>
<% end %>

<div class="mx-auto h-full xl:flex xl:justify-center overflow-auto">
  <turbo-frame id="project" class="flex gap-6 h-full w-full">
    <div class="app-scroll-container bg-[#1D1D1D] rounded-lg h-full flex flex-col w-[25rem] lg:w-[28rem] 2xl:w-[30rem] grow-0 shrink-0 overflow-y-auto">
      <div class="px-6 pt-6 pb-2">Done</div>
      <%= render 'done', project: @project %>
    </div>
    <div class="app-scroll-container bg-[#1D1D1D] rounded-lg h-full flex flex-col w-[25rem] lg:w-[28rem] 2xl:w-[30rem] grow-0 shrink-0 overflow-y-auto">
      <div class="px-6 pt-6 pb-2">Current Iteration / Backlog</div>
      <%= render 'iteration', project: @project, height_full: false %>
      <%= render 'backlog', project: @project %>
    </div>
    <div class="app-scroll-container bg-[#1D1D1D] rounded-lg h-full py-6 flex flex-col w-[25rem] lg:w-[28rem] 2xl:w-[30rem] grow-0 shrink-0 relative overflow-y-auto">
      <div class="mb-2 h-[30px] px-6">Icebox</div>
      <%= render 'icebox', project: @project %>
    </div>
  </turbo-frame>
</div>
