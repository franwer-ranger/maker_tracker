<div class="container mx-auto">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Projects</h1>
    <turbo-frame id="new_project">
      <%= link_to 'Create project', new_project_path, class: 'rounded-lg py-2 px-5 bg-[#FF3F01] text-white inline-block font-medium cursor-pointer' %>
    </turbo-frame>
  </div>

  <div id="projects" class="grid grid-cols-3 gap-3 w-full my-8">
    <%= render @projects %>
  </div>
</div>
