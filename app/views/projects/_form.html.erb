<div class="bg-[#F1F1F1] text-black w-full rounded-lg px-4 pt-1 pb-8">
  <%= form_with(model: project, class: 'contents', html: { 'data-turbo-frame': '_top' }) do |form| %>
    <div class="flex justify-between my-4 items-center">
      <%= link_to 'Cancel', projects_path, class: 'mx-2 underline text-sm', 'data-turbo-frame': '_top' %>
      <%= form.submit 'Save', class: 'rounded-lg py-2 px-5 bg-[#FF3F01] text-white inline-block font-medium cursor-pointer' %>
    </div>

    <div class="my-4 px-6 py-8 bg-white rounded-lg">
      <label class="font-medium">Name</label>
      <%= form.text_field :name, class: 'block rounded-md border border-gray-400 outline-none px-3 py-2 mt-2 w-full' %>
    </div>

    <div class="my-4 px-6 py-8 bg-white rounded-lg">
      <label class="font-medium">Description</label>
      <%= form.text_area :description, rows: 3, class: 'block rounded-md border border-gray-400 outline-none px-3 py-2 mt-2 w-full' %>
    </div>

    <div class="my-4 px-6 py-3 bg-white rounded-lg flex justify-between items-center">
      <label class="font-medium">Start Date</label>
      <%= form.date_field :start_date, value: Date.today, class: 'border-transparent focus:border-transparent focus:ring-0 pl-3 py-2 mt-2 text-right' %>
    </div>

    <div class="my-4 px-6 py-3 bg-white rounded-lg flex justify-between items-center">
      <label class="font-medium flex-grow">Initial velocity</label>
      <%= form.number_field :velocity, value: 10, class: 'block rounded-md border border-gray-400 outline-none px-3 py-2 mt-2 w-[80px] text-center' %>
    </div>

    <div class="my-4 px-6 py-3 bg-white rounded-lg flex justify-between items-center">
      <%= form.label 'Iteration length (weeks)' %>
      <%= form.number_field :sprint_length, value: 2, class: 'block rounded-md border border-gray-400 outline-none px-3 py-2 mt-2 w-[80px] text-center' %>
    </div>
  <% end %>
</div>
