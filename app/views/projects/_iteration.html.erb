<turbo-frame id="iteration" class="h-full">
  <div class="relative flex flex-col w-full h-full overflow-y-auto" data-projects-target="iteration">
    <%= render 'sprints/header', sprint: project.current_sprint %>
    <div class="flex flex-col h-full gap-1 z-20" data-projects-target="items" data-list="iteration" data-sprint-id="<%= project.current_sprint.id %>">
      <% project.current_sprint.items.order(:position).each do |item| %>
        <%= render item %>
      <% end %>
    </div>
    <% if project.current_sprint.items.empty? %>
      <div class="absolute h-full w-full flex justify-center items-center">
        <div class="flex flex-col items-center">
          <%= image_tag 'backlog_empty.svg', class: 'h-60' %>
          <div class="text-xs font-thin my-4">
            No items have been added to the current iteration yet.
          </div>
        </div>
      </div>
    <% end %>
  </div>
</turbo-frame>
