<% summary, summary_class = milestone_summary(milestone) %>
<% stories = milestone.stories.to_a %>
<li data-id="<%= milestone.id %>">
  <%= tag.details class: "group rounded-lg border border-border pl-4 pr-5 open:border-strong open:bg-surface-sunken open:pb-2", open: milestone == @open_milestone do %>
    <summary class="flex min-h-[50px] cursor-pointer list-none items-center gap-3 rounded-md group-open:items-start group-open:pb-4 group-open:pt-[18px] <%= ComponentsHelper::FOCUS_RING %> [&::-webkit-details-marker]:hidden">
      <span class="cursor-grab text-text-subtle group-open:mt-0.5" data-handle data-action="pointerdown->roadmap#suspendStories click->roadmap#preventToggle" title="Arrastra para reordenar"><%= icon "bars-2", size: 16 %></span>
      <span class="w-8 shrink-0 font-mono text-control <%= milestone.closed? ? "text-text-subtle" : "text-text-muted group-open:text-text" %> group-open:leading-5"><%= milestone.code %></span>
      <span class="flex grow flex-col gap-1">
        <span class="text-base leading-5 group-open:text-lg group-open:font-semibold group-open:leading-[22px] <%= milestone.closed? ? "text-text-muted" : "text-text" %>"><%= milestone.title %></span>
        <% if milestone.goal.present? %>
          <span class="hidden text-control leading-[18px] text-text-muted group-open:block">Objetivo: <%= milestone.goal.sub(/\A./) { it.downcase } %></span>
        <% end %>
      </span>
      <span class="font-mono text-xs group-open:leading-5 <%= summary_class %>"><%= summary %></span>
    </summary>

    <div class="flex flex-col pl-[60px]">
      <ol class="flex min-h-2 flex-col" data-roadmap-target="stories" data-milestone="<%= milestone.id %>">
        <% stories.reject(&:done?).each do |story| %>
          <%= render "roadmaps/story", story: story %>
        <% end %>
      </ol>

      <% done = stories.select(&:done?) %>
      <% if done.any? %>
        <details class="group/done">
          <summary class="flex h-11 cursor-pointer list-none items-center gap-4 border-t border-border <%= ComponentsHelper::FOCUS_RING %> [&::-webkit-details-marker]:hidden">
            <span class="flex w-[104px] shrink-0 items-center gap-2"><%= state_dot :done %><span class="text-control text-text-muted">Hechas</span></span>
            <span class="w-10 shrink-0 font-mono text-control text-text-muted"><%= done.size %></span>
            <span class="grow font-mono text-xs leading-[18px] text-text-muted">
              <%= done.map { "##{it.number}" }.sort_by { it[1..].to_i }.join(" ") %> ·
              <span class="group-open/done:hidden">mostrar</span><span class="hidden group-open/done:inline">ocultar</span>
            </span>
          </summary>
          <ol class="flex flex-col">
            <% done.each do |story| %>
              <%= render "roadmaps/story", story: story %>
            <% end %>
          </ol>
        </details>
      <% end %>

      <div class="flex justify-end border-t border-border pt-1">
        <% if milestone.closed? %>
          <%= button_to "Reabrir hito", project_milestone_closure_path(@project, milestone), method: :delete,
                class: "h-control-sm rounded-md px-3 text-control font-medium text-text-muted hover:text-text #{ComponentsHelper::FOCUS_RING}" %>
        <% else %>
          <%= button_to "Cerrar hito", project_milestone_closure_path(@project, milestone),
                class: "h-control-sm rounded-md px-3 text-control font-medium text-text-muted hover:text-text #{ComponentsHelper::FOCUS_RING}" %>
        <% end %>
      </div>
    </div>
  <% end %>
</li>
