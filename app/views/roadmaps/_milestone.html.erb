<% stories = milestone.stories.to_a %>
<%# Un hito del Roadmap (5.3). En el móvil: bloque a todo el ancho con borde abajo, fila de 56px con chevron (sin asa: no se arrastra) y, abierto, sobre surface-sunken con su objetivo. %>
<% editing = agent_writing(@project, "#{@project.key} #{milestone.code}") %>
<li data-id="<%= milestone.id %>">
  <%= tag.details class: "#{'md:!border-[color-mix(in_srgb,var(--color-accent)_70%,transparent)] ' if editing}group rounded-lg border border-border pl-4 pr-5 open:border-strong open:bg-surface-sunken open:pb-2 max-md:rounded-none max-md:border-0 max-md:border-b max-md:px-0 max-md:open:border-border max-md:open:pb-0", open: milestone == @open_milestone do %>
    <summary class="flex min-h-[50px] cursor-pointer list-none items-center gap-3 rounded-md group-open:items-start group-open:pb-4 group-open:pt-[18px] <%= ComponentsHelper::FOCUS_RING %> [&::-webkit-details-marker]:hidden max-md:min-h-14 max-md:flex-wrap max-md:gap-x-2.5 max-md:gap-y-1.5 max-md:rounded-none max-md:px-4 max-md:group-open:pb-3 max-md:group-open:pt-4">
      <span class="cursor-grab text-text-subtle group-open:mt-0.5 max-md:hidden" data-handle data-action="pointerdown->roadmap#suspendStories click->roadmap#preventToggle" title="Arrastra para reordenar"><%= icon "bars-2", size: 16 %></span>
      <%= icon "chevron-right", size: 16, class: "text-text-muted transition-transform duration-150 ease-brand group-open:mt-1 group-open:rotate-90 group-open:text-text md:hidden" %>
      <span class="w-8 shrink-0 font-mono text-control <%= milestone.closed? ? "text-text-subtle" : "text-text-muted group-open:text-text" %> group-open:leading-5 max-md:w-6 max-md:text-xs max-md:group-open:leading-6"><%= milestone.code %></span>
      <span class="flex grow flex-col gap-1 max-md:basis-0">
        <span class="text-base leading-5 group-open:text-lg group-open:font-semibold group-open:leading-[22px] <%= milestone.closed? ? "text-text-muted" : "text-text" %> max-md:text-[15px] max-md:group-open:text-[17px] max-md:group-open:leading-6"><%= milestone.title %></span>
        <% if milestone.goal.present? %>
          <span class="hidden text-control leading-[18px] text-text-muted group-open:block max-md:group-open:hidden">Objetivo: <%= milestone.goal.sub(/\A./) { it.downcase } %></span>
        <% end %>
      </span>
      <span class="font-mono text-xs group-open:leading-5 max-md:shrink-0 max-md:group-open:leading-6"><%= editing ? agent_editing_label(editing) : milestone_summary_tag(milestone) %></span>
      <% if milestone.goal.present? %>
        <span class="hidden w-full pl-[60px] text-control leading-5 text-text-muted max-md:group-open:block md:hidden"><%= milestone.goal %></span>
      <% end %>
    </summary>

    <div class="flex flex-col pl-[60px] max-md:pl-4">
      <ol class="flex min-h-2 flex-col max-md:min-h-0" data-roadmap-target="stories" data-milestone="<%= milestone.id %>">
        <% stories.reject(&:done?).each do |story| %>
          <%= render "roadmaps/story", story: story %>
        <% end %>
      </ol>

      <% done = stories.select(&:done?) %>
      <% if done.any? %>
        <details class="group/done">
          <summary class="flex h-11 cursor-pointer list-none items-center gap-4 border-t border-border <%= ComponentsHelper::FOCUS_RING %> [&::-webkit-details-marker]:hidden max-md:h-[52px] max-md:gap-2 max-md:pr-4">
            <span class="flex w-[104px] shrink-0 items-center gap-2 max-md:w-4"><%= state_dot :done %><span class="text-control text-text-muted max-md:hidden">Hechas</span></span>
            <span class="w-10 shrink-0 font-mono text-control text-text-muted max-md:w-9 max-md:leading-5"><%= done.size %></span>
            <span class="grow text-[15px] leading-5 text-text-muted md:hidden">Hechas</span>
            <span class="grow font-mono text-xs leading-[18px] text-text-muted max-md:grow-0">
              <span class="max-md:hidden"><%= done.map { "##{it.number}" }.sort_by { it[1..].to_i }.join(" ") %> ·</span>
              <span class="group-open/done:hidden">mostrar</span><span class="hidden group-open/done:inline">ocultar</span>
            </span>
          </summary>
          <ol class="flex flex-col">
            <% done.each do |story| %>
              <%= render "roadmaps/story", story: story %>
            <% end %>
          </ol>
        </details>
      <% end %>

      <div class="flex justify-end border-t border-border pt-1 max-md:hidden">
        <% if milestone.closed? %>
          <%= button_to "Reabrir hito", project_milestone_closure_path(@project, milestone), method: :delete,
                class: "h-control-sm rounded-md px-3 text-control font-medium text-text-muted hover:text-text #{ComponentsHelper::FOCUS_RING}" %>
        <% else %>
          <%= button_to "Cerrar hito", project_milestone_closure_path(@project, milestone),
                class: "h-control-sm rounded-md px-3 text-control font-medium text-text-muted hover:text-text #{ComponentsHelper::FOCUS_RING}" %>
        <% end %>
      </div>
    </div>
  <% end %>
</li>
