<%# Fila de historia (5.3): estado (104) · #n (40) · título · metadato.
    En el móvil (Fila de historia · Móvil): punto (16) · #n (36) · título en hasta dos líneas · metadato, de al menos 52px. %>
<li data-number="<%= story.number %>">
  <%= link_to project_story_path(@project, story), draggable: false,
        class: "flex h-11 items-center gap-4 border-t border-border transition-colors duration-150 ease-brand hover:bg-surface #{ComponentsHelper::FOCUS_RING} max-md:h-auto max-md:min-h-[52px] max-md:gap-2 max-md:py-2 max-md:pr-4" do %>
    <span class="flex w-[104px] shrink-0 items-center gap-2 max-md:w-4">
      <%= state_dot story.state, halo: false %>
      <span class="text-control text-text-muted max-md:hidden"><%= story.human_state %></span>
    </span>
    <span class="w-10 shrink-0 font-mono text-control text-text-muted max-md:w-9 max-md:leading-5">#<%= story.number %></span>
    <span class="grow truncate text-sm leading-[18px] <%= story.done? ? "text-text-muted" : "text-text" %> max-md:line-clamp-2 max-md:basis-0 max-md:whitespace-normal max-md:text-[15px] max-md:leading-5"><%= story.title %></span>
    <span class="shrink-0"><%= story_card_meta story, @context %></span>
  <% end %>
</li>
