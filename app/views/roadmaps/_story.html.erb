<%# Fila de historia (5.3): estado (104) · #n (40) · título · metadato. %>
<li data-number="<%= story.number %>">
  <%= link_to project_story_path(@project, story), draggable: false,
        class: "flex h-11 items-center gap-4 border-t border-border transition-colors duration-150 ease-brand hover:bg-surface #{ComponentsHelper::FOCUS_RING}" do %>
    <span class="flex w-[104px] shrink-0 items-center gap-2">
      <%= state_dot story.state, halo: false %>
      <span class="text-control text-text-muted"><%= story.human_state %></span>
    </span>
    <span class="w-10 shrink-0 font-mono text-control text-text-muted">#<%= story.number %></span>
    <span class="grow truncate text-sm leading-[18px] <%= story.done? ? "text-text-muted" : "text-text" %>"><%= story.title %></span>
    <span class="shrink-0"><%= story_card_meta story, @context %></span>
  <% end %>
</li>
