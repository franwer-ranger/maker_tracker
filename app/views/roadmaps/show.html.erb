<% content_for :title, "Roadmap · #{@project.name}" %>
<div class="flex flex-col gap-8 px-4 pb-10 md:px-12 md:py-10"
     data-controller="roadmap"
     data-roadmap-milestone-url-value="<%= project_milestone_position_path(@project, "__id__") %>"
     data-roadmap-story-url-value="<%= project_story_position_path(@project, "__id__") %>">
  <%= render "shared/project_header", project: @project %>
  <header class="flex w-[920px] max-w-full items-end justify-between gap-8 max-md:-mt-5 max-md:flex-col max-md:items-start max-md:gap-2">
    <div class="flex flex-col gap-2.5 max-md:gap-2">
      <h1 class="font-display text-display-sm tracking-[-0.01em] max-md:tracking-[-0.015em]">Roadmap</h1>
      <p class="text-sm text-text-muted">Qué construimos y en qué orden. El orden es la prioridad<span class="max-md:hidden">: arrastra para cambiarlo.</span><span class="md:hidden">.</span></p>
    </div>
    <div class="flex shrink-0 items-center gap-6 max-md:flex-wrap max-md:gap-x-6 max-md:gap-y-3 max-md:pt-2">
      <%= render "shared/ready_work", project: @project %>
      <%= render "roadmaps/new_milestone" %>
    </div>
  </header>

  <%= render "roadmaps/pending" %>
  <% if flash[:alert] %>
    <p class="text-control text-accent" role="alert"><%= flash[:alert] %></p>
  <% end %>

  <%# En el móvil (5.3 · Móvil) los hitos van a sangre, separados por bordes, sin tarjetas. %>
  <div class="flex w-[920px] max-w-full flex-col gap-2 max-md:-mx-4 max-md:-mt-3 max-md:w-auto max-md:max-w-none max-md:gap-0 max-md:border-t max-md:border-border">
    <ol class="flex flex-col gap-2 max-md:gap-0" data-roadmap-target="milestones">
      <% @milestones.each do |milestone| %>
        <%= render "roadmaps/milestone", milestone: milestone %>
      <% end %>
    </ol>

    <%= render "roadmaps/ideas" %>
  </div>
</div>
