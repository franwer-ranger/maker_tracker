<% content_for :title, "Editar brief · #{@project.name}" %>
<div class="flex items-start gap-16 px-12 py-10">
  <%= form_with model: @project, url: project_brief_path(@project), method: :patch, class: "flex min-w-0 grow basis-0 flex-col gap-5", id: "brief-form" do |form| %>
    <%# Versión con la que se abrió (MT-37): si el brief cambia mientras editas, se avisa y se enseña qué cambió. %>
    <%= hidden_field_tag :version, @form_version || @project.brief_version, id: nil %>
    <%= hidden_field_tag :base_brief, (@base_brief || @project.brief).to_s.strip, id: nil %>
    <header class="flex flex-col gap-2.5">
      <h1 class="font-display text-display tracking-[-0.02em]">Brief</h1>
      <p class="text-sm text-text-muted">Visión, principios, fuera de alcance y glosario. Lo primero que lee cualquier agente.</p>
    </header>

    <%= render "components/markdown_editor", form: form, attribute: :brief, label: "Brief en markdown", doc: true %>

    <% if @notice %>
      <p class="text-control leading-[18px] text-state-defining" role="status"><%= @notice %> Revisa y guarda.</p>
    <% end %>
    <% if @conflict %>
      <%= render "shared/edit_conflict", conflict: @conflict, form_id: "brief-form", discard_path: edit_project_brief_path(@project) %>
    <% else %>
      <div class="flex items-center justify-end gap-2">
        <span class="grow font-mono text-xs text-text-subtle">Se guarda como <%= Current.actor.name %> · queda en el historial</span>
        <%= ui_button "Cancelar", variant: :ghost, href: project_brief_path(@project) %>
        <%= ui_button "Guardar", type: "submit" %>
      </div>
    <% end %>
  <% end %>

  <%= render "briefs/decisions" %>
</div>
