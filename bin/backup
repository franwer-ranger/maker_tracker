#!/bin/bash -e

# Backs up the production database (and the generated secret) into
# /rails/backups/<UTC timestamp>/. Runs inside the container:
#
#   bin/backup          one backup now
#   bin/backup --loop   one backup every BACKUP_INTERVAL_HOURS (24), keeping
#                       the newest BACKUP_KEEP (14)

STORAGE=/rails/storage
BACKUPS=/rails/backups
DATABASE="$STORAGE/production.sqlite3"
KEEP="${BACKUP_KEEP:-14}"
INTERVAL_HOURS="${BACKUP_INTERVAL_HOURS:-24}"

backup() {
  if [ ! -f "$DATABASE" ]; then
    echo "backup: $DATABASE does not exist yet, skipping"
    return 0
  fi

  local name tmp check
  name="$(date -u +%Y%m%d-%H%M%S)"
  tmp="$BACKUPS/.$name"
  mkdir -p "$tmp"

  # .backup takes a consistent copy even while the app is writing.
  sqlite3 "$DATABASE" ".backup '$tmp/production.sqlite3'"
  check="$(sqlite3 "$tmp/production.sqlite3" "PRAGMA integrity_check;")"
  if [ "$check" != "ok" ]; then
    echo "backup: integrity check failed: $check" >&2
    rm -rf "$tmp"
    return 1
  fi
  [ -f "$STORAGE/secret_key_base" ] && cp -p "$STORAGE/secret_key_base" "$tmp/"

  mv "$tmp" "$BACKUPS/$name"
  echo "backup: $BACKUPS/$name ($(du -sh "$BACKUPS/$name" | cut -f1))"

  # Keep only the newest $KEEP backups.
  ls -1d "$BACKUPS"/[0-9]*/ 2>/dev/null | sort | head -n "-$KEEP" | xargs -r rm -rf
}

if [ "$1" = "--loop" ]; then
  while true; do
    backup || echo "backup: failed, will retry in ${INTERVAL_HOURS}h" >&2
    sleep "$((INTERVAL_HOURS * 3600))"
  done
else
  backup
fi
