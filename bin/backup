#!/bin/bash -e

# Backs up the production database, the generated secret and the attachments
# (storage/attachments, MT-96) into /rails/backups/<UTC timestamp>/. Runs inside
# the container:
#
#   bin/backup          one backup now
#   bin/backup --loop   one backup every BACKUP_INTERVAL_HOURS (24), keeping
#                       the newest BACKUP_KEEP (14)

# `docker compose exec` skips the entrypoint and runs as root: switch to the app
# user so backups and the database never end up owned by root.
if [ "$(id -u)" = "0" ]; then
  HOME=/home/rails exec setpriv --reuid=rails --regid=rails --init-groups "$0" "$@"
fi

STORAGE=/rails/storage
BACKUPS=/rails/backups
DATABASE="$STORAGE/production.sqlite3"
ATTACHMENTS="$STORAGE/attachments"
KEEP="${BACKUP_KEEP:-14}"
INTERVAL_HOURS="${BACKUP_INTERVAL_HOURS:-24}"

# Copies the attachments into $1. Starting from the previous backup with
# hardlinks, each backup only takes the space of what was uploaded since (with
# BACKUP_KEEP=14 a plain copy would keep 14 copies of every video); storage/
# and backups/ are different mounts, so they can't be hardlinked to storage/.
copy_attachments() {
  local dest="$1" prev
  prev="$(ls -1d "$BACKUPS"/[0-9]*/ 2>/dev/null | sort | tail -n 1)"
  if [ -z "$prev" ] || [ ! -d "$prev/attachments" ]; then
    cp -a "$ATTACHMENTS" "$dest"
    return
  fi

  cp -al "$prev/attachments" "$dest"
  cp -a --update=none "$ATTACHMENTS/." "$dest/"
  # Drop what was deleted since (a deleted page purges its attachments).
  (cd "$dest" && find . -type f -print0) | while IFS= read -r -d '' file; do
    [ -e "$ATTACHMENTS/$file" ] || rm -f "$dest/$file"
  done
}

backup() {
  if [ ! -f "$DATABASE" ]; then
    echo "backup: $DATABASE does not exist yet, skipping"
    return 0
  fi

  local name tmp check
  name="$(date -u +%Y%m%d-%H%M%S)"
  tmp="$BACKUPS/.$name"
  mkdir -p "$tmp"

  # .backup takes a consistent copy even while the app is writing.
  sqlite3 "$DATABASE" ".backup '$tmp/production.sqlite3'"
  # A self-contained file: out of WAL mode, it opens without write access.
  sqlite3 "$tmp/production.sqlite3" "PRAGMA journal_mode=DELETE;" > /dev/null
  check="$(sqlite3 "$tmp/production.sqlite3" "PRAGMA integrity_check;")"
  if [ "$check" != "ok" ]; then
    echo "backup: integrity check failed: $check" >&2
    rm -rf "$tmp"
    return 1
  fi
  [ -f "$STORAGE/secret_key_base" ] && cp -p "$STORAGE/secret_key_base" "$tmp/"
  # Attachment files never change once uploaded: a plain copy is consistent.
  if [ -d "$ATTACHMENTS" ]; then copy_attachments "$tmp/attachments"; fi

  mv "$tmp" "$BACKUPS/$name"
  echo "backup: $BACKUPS/$name ($(du -sh "$BACKUPS/$name" | cut -f1))"

  # Keep only the newest $KEEP backups.
  ls -1d "$BACKUPS"/[0-9]*/ 2>/dev/null | sort | head -n "-$KEEP" | xargs -r rm -rf
}

if [ "$1" = "--loop" ]; then
  while true; do
    backup || echo "backup: failed, will retry in ${INTERVAL_HOURS}h" >&2
    sleep "$((INTERVAL_HOURS * 3600))"
  done
else
  backup
fi
