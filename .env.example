# Optional settings for docker compose. Copy to .env and uncomment what you need.

# Port on this machine (always bound to 127.0.0.1).
# MAKER_TRACKER_PORT=3002

# Where the database, the generated secret and the backups live.
# MAKER_TRACKER_DATA=./data

# Backups: how often, and how many to keep.
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14

# Generated on first boot into $MAKER_TRACKER_DATA/storage/secret_key_base if empty.
# SECRET_KEY_BASE=

# Push notifications (see docs/SELF_HOSTING.md). Generate them with:
#   docker compose exec -u rails app bin/rails "mt:vapid[mailto:you@example.com]"
# Changing them invalidates every device's subscription.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
